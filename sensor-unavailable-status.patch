+// Returns true for HA device classes that represent weather station / temperature probe measurements.
+// Only these sensor types receive an expire_after in their discovery config so that Home Assistant
+// marks them "unavailable" after a period of silence rather than keeping stale values.
+static bool isWeatherSensor(const char* device_class) {
+  static const char* weatherClasses[] = {
+    "temperature", "humidity", "pressure",
+    "wind_speed", "precipitation", "precipitation_intensity"
+  };
+  for (const char* cls : weatherClasses) {
+    if (strcmp(device_class, cls) == 0)
+      return true;
+  }
+  return false;
+}
